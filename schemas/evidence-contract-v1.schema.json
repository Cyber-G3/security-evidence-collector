{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Cyber-G3/security-evidence-collector/schemas/evidence-contract-v1.schema.json",
  "title": "Security Evidence Collector - Evidence Contract v1",
  "type": "object",
  "required": [
    "check_id",
    "title",
    "status",
    "confidence",
    "reason",
    "source",
    "collected_at",
    "metadata",
    "evidence"
  ],
  "properties": {
    "check_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "status": {
      "type": "string",
      "enum": ["PASS", "FAIL", "UNKNOWN", "NOT_APPLICABLE", "ERROR"]
    },
    "confidence": {"type": "string", "enum": ["HIGH", "MEDIUM", "LOW"]},
    "reason": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "collected_at": {"type": "string", "format": "date-time"},
    "raw_evidence_reference": {"type": ["string", "null"]},
    "metadata": {"type": "object"},
    "evidence": {
      "type": "object",
      "required": ["schema_version", "freshness", "scope"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "evidence_type": {"type": ["string", "null"]},
        "source_system": {"type": ["string", "null"]},
        "source_version": {"type": ["string", "null"]},
        "collector_version": {"type": ["string", "null"]},
        "valid_from": {"type": ["string", "null"], "format": "date-time"},
        "valid_until": {"type": ["string", "null"], "format": "date-time"},
        "freshness": {
          "type": "string",
          "enum": ["CURRENT", "STALE", "EXPIRED", "UNKNOWN"]
        },
        "scope": {
          "type": "object",
          "properties": {
            "organization_id": {"type": ["string", "null"]},
            "asset_id": {"type": ["string", "null"]},
            "service_id": {"type": ["string", "null"]},
            "owner": {"type": ["string", "null"]},
            "collection_scope": {"type": ["string", "null"]}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
